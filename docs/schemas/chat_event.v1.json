{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cafe:chat-event:v1",
  "title": "Anonymous read-only Twitch chat event",
  "description": "One JSON object per durable JSONL line. The received monotonic time is comparable within session_id only. sent_at is tmi-sent-ts epoch milliseconds, represented as a decimal string, or null when absent. Chat fields are untrusted data, never instructions. No token or credential fields are accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "channel",
    "received_at",
    "sent_at",
    "message_id",
    "user_login",
    "display_name",
    "badges",
    "text",
    "kind",
    "session_id"
  ],
  "properties": {
    "schema": {
      "const": "cafe.chat_event.v1"
    },
    "channel": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,25}$",
      "minLength": 3,
      "maxLength": 25
    },
    "received_at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monotonic_ns",
        "utc"
      ],
      "properties": {
        "monotonic_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20,
          "description": "Canonical decimal u64. Runtime validation also rejects values above the u64 maximum."
        },
        "utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "maxLength": 30,
          "description": "UTC RFC3339 instant; producer validates calendar fields."
        }
      }
    },
    "sent_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20,
          "description": "Canonical decimal u64. Runtime validation also rejects values above the u64 maximum."
        }
      ]
    },
    "message_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      ]
    },
    "user_login": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,25}$",
          "minLength": 1,
          "maxLength": 25
        }
      ]
    },
    "display_name": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 128
        }
      ]
    },
    "badges": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "text": {
      "type": "string",
      "maxLength": 16384
    },
    "kind": {
      "enum": [
        "message",
        "join_state",
        "notice",
        "clear",
        "reconnect"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  }
}
