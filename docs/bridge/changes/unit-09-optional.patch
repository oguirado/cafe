+// OPTIONAL: exact identity selection for pairing/capture only; PENDING-LIVE.
+// OBS continues to receive the full registry and its unique-descriptor rule.
+impl WindowRegistry {
+    pub(crate) fn resolve_exact_for_capture(&self, handle: &WindowHandle, generation: Clock) -> Result<WindowView, WindowError> {
+        let entry = self.entries.values().find(|entry| &entry.view.handle == handle && entry.view.generation == generation).ok_or(WindowError::StaleWindow)?;
+        if !entry.view.visible || entry.view.minimized { return Err(WindowError::Unavailable); }
+        Ok(entry.view.clone())
+    }
+
+    /// Narrow adapter for existing pairing/capture APIs. The selected entry's
+    /// native witness is retained unchanged; no descriptor or token is forged.
+    /// Construct afresh from the authority's live registry for every check.
+    pub(crate) fn for_capture(&self, handle: &WindowHandle, generation: Clock) -> Result<Self, WindowError> {
+        self.resolve_exact_for_capture(handle, generation)?;
+        let (key, entry) = self.entries.iter().find(|(_, entry)| &entry.view.handle == handle && entry.view.generation == generation).ok_or(WindowError::StaleWindow)?;
+        let mut entries = BTreeMap::new();
+        entries.insert(key.clone(), entry.clone());
+        Ok(Self { epoch: self.epoch, next: self.next, entries })
+    }
+}
